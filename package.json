{
  "name": "appliance-price-tracker",
  "private": true,
  "workspaces": [
    "packages/shared",
    "packages/api",
    "packages/scraper",
    "packages/web"
  ],
  "scripts": {
    "db:generate": "npm run generate --workspace=packages/shared",
    "db:migrate": "npm run migrate --workspace=packages/shared",
    "db:seed": "npm run seed --workspace=packages/shared",
    "scrape": "npm run start --workspace=packages/scraper",
    "api:dev": "npm run dev --workspace=packages/api",
    "web:dev": "npm run dev --workspace=packages/web",
    "build": "npm run build --workspace=packages/shared && npm run build --workspace=packages/api && npm run build --workspace=packages/scraper && npm run build --workspace=packages/web"
  },
  "engines": {
    "node": ">=20"
  }
}
