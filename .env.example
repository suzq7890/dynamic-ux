# Copy this file to .env at the repo root for local development, and load
# it into your shell before running npm scripts, e.g.:
#   set -a && source .env && set +a
# In production (GitHub Actions, your API host), set these as real
# environment variables / secrets instead of committing a .env file.

# Postgres connection string for an external database (Neon, Supabase,
# Railway, RDS, etc). Must be reachable both from GitHub Actions (for the
# daily scraper) and from wherever you host the API.
DATABASE_URL="postgresql://user:password@host:5432/price_tracker?sslmode=require"

# Gmail address used to SEND alert emails, and an App Password for it
# (Google Account -> Security -> 2-Step Verification -> App Passwords).
# Do not use your real Gmail password here.
GMAIL_USER="you@gmail.com"
GMAIL_APP_PASSWORD="xxxx xxxx xxxx xxxx"

# Where alert emails are sent. Defaults to GMAIL_USER if omitted.
ALERT_EMAIL_TO="you@gmail.com"

# Port the API server listens on (local dev / self-hosting).
PORT=4000

# Used by the web app in production builds to point at your deployed API,
# e.g. https://api.yourdomain.com/api. Leave unset for local dev - Vite's
# dev server proxies /api to http://localhost:4000 automatically.
# VITE_API_BASE_URL="/api"
